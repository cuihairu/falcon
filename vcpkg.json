{
  "name": "falcon",
  "version": "0.1.0",
  "description": "A modern, high-performance, cross-platform download manager",
  "homepage": "https://github.com/cuihairu/falcon",
  "license": "Apache-2.0",
  "dependencies": [
    {
      "name": "nlohmann-json"
    },
    {
      "name": "spdlog"
    },
    "curl",
    "openssl",
    "fmt",
    "sqlite3",
    {
      "name": "gtest",
      "version>=": "1.12.0"
    },
    "miniupnpc",
    "libnatpmp",
    {
      "name": "expat",
      "default-features": false
    }
  ],
  "features": {
    "desktop": {
      "description": "Build desktop GUI application",
      "dependencies": [
        {
          "name": "qtbase",
          "default-features": false,
          "features": [
            "widgets",
            "network",
            "concurrent"
          ],
          "platform": "!linux"
        },
        {
          "name": "qtsvg",
          "platform": "!linux"
        }
      ]
    },
    "bittorrent": {
      "description": "BitTorrent full data plane (download/seeding) via libtorrent",
      "dependencies": [
        "libtorrent"
      ]
    }
  },
  "builtin-baseline": "89dd0f4d241136b843fb55813b2f0fa6448c204d"
}
