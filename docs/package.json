{
  "name": "falcon-docs",
  "version": "0.1.0",
  "description": "Falcon 下载器文档",
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "docs:dev": "vitepress dev .",
    "docs:build": "vitepress build .",
    "docs:preview": "vitepress preview .",
    "docs:clean": "node -e \"const fs=require('fs'); for (const path of ['.vitepress/dist','.vitepress/cache','.vitepress/.temp']) fs.rmSync(path,{recursive:true,force:true})\""
  },
  "keywords": [
    "falcon",
    "downloader",
    "documentation"
  ],
  "author": "Falcon Team",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "vitepress": "^1.6.3"
  },
  "pnpm": {
    "overrides": {
      "vite@<6.4.5": "6.4.5"
    }
  }
}
