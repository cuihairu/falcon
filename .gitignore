/Makefile

# Dependencies
_deps/
vcpkg_installed/

# Compiled libraries（锚定仓库根——嵌套 lib/ 如 packaging/openwrt/usr/lib 是源码树）
/lib/
*.a
*.so
*.dylib
*.dll

# Binaries（锚定仓库根——packaging/*/usr/bin 是打包源码树）
/bin/
*.exe
*.out
*.app

# Testing
Testing/
*.log

# Coverage (gcov/gcovr artifacts)
*.gcda
*.gcno
*.gcov
coverage/
coverage*.xml
coverage*.html
*.info
lcov*.info

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code 本地文件（个人设置/技能/运行时产物；index.json 为项目 AI 索引，保留跟踪）
.claude/*
!.claude/index.json

# OS
.DS_Store
Thumbs.db

# Node.js
node_modules/
package-lock.json

# 会话临时产物（测试残渣/截图/探针输出；目录名以字面量固定——"--help" 为工具误产出目录）
.tmp/
ui_shots*/
ui_redesign/
--help/
