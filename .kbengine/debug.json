// kode 调试与快速执行动作配置(文件缺失时自动生成)
// 本文件按 JSONC 解析,允许 // 与块注释(同 tsconfig.json 口径),
// kode 读配置前会剥注释,所以这里的注释不影响生效。
//
// 当前生效工作目录:d:\workspaces\falcon
// 来源:默认值(首个工作区根)
//   - 无冲突
//
// 工作目录优先级(高 → 低):
//   1. 环境变量 KBENGINE_WORKSPACE(支持 VS Code 官方变量替换,例如 ${workspaceFolder}/server)
//   2. 本文件顶层的 "workspaceRoot"
//   3. 默认取首个工作区根
// 想让本文件接管,取消下面一行注释并改成你的路径:
// "workspaceRoot": "${workspaceFolder}",

{
  // 配置版本号,当前固定 1.0
  "version": "1.0",

  // telnet 调试段:只影响「Start Debugging」的提示语与自动登录预填,不参与实际探测
  "debug": {
    // 默认 telnet 主机;留空按本机回环 127.0.0.1
    "defaultTelnetHost": "127.0.0.1",
    // 默认 telnet 端口;0 表示不预填,按元件各自的端口走
    "defaultTelnetPort": 0,
    // 逐元件覆盖默认;键是元件名,值可含 telnetHost / telnetPort / telnetPassword /
    // telnetDefaultLayer / telnetEnableCommands / pathMappings
    "components": {
  //     "loginapp": { "telnetHost": "127.0.0.1", "telnetPort": 31000, "telnetPassword": "", "telnetDefaultLayer": "python", "telnetEnableCommands": [] },
  //     "dbmgr": { "telnetHost": "127.0.0.1", "telnetPort": 32000, "telnetPassword": "", "telnetDefaultLayer": "python", "telnetEnableCommands": [] },
    }
  },

  // 快速执行动作:实体浏览器 ▶ 与命令面板共用;三种后端任选其一
  //   script:跑本地脚本   { "name": "起服", "type": "script", "script": "${workspaceFolder}/start_server.bat", "background": true }
  //   venv:需要 Python 环境时加 "venv": { "enabled": true },按 kbengine.python.venvDirectories 自动查找(默认 .venv/venv/.kbenv)
  //   command:跑引擎命令 { "name": "导出配置表", "type": "command", "command": "exportTables" }
  //   http:发 HTTP     { "name": "热更接口", "type": "http", "url": "http://127.0.0.1:8090/hotfix?module_name=${module}", "method": "POST", "body": "module_name=${module}" }
  "quickActions": []
}
