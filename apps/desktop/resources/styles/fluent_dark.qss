/* ============================================================
   Falcon Desktop · Warm Console Dark
   token: window {{window}} · card {{surface}} · text {{text}}
          text-secondary {{text_secondary}} · text-disabled {{text_disabled}}
          accent {{accent}} (hover {{accent_hover}} / pressed {{accent_pressed}})
          accent 上文字 {{accent_text}} · divider {{card}}
          hover rgba(255,255,255,15) · danger {{danger}}
   设计语言与文档站同源「warm console」:暖黑底 + falcon 橙单强调;
   对比度基线 WCAG AA({{accent}} 于暗底 9.0:1,深咖啡字于其上 9.1:1)。
   形状刻度(单一规则,全表执行):
     按钮/输入 8px · 卡片/面板(组框/菜单/Hero/任务卡) 12px
     · 小件(工具钮/行内钮/菜单项/提示/导航段) 4px · 条形(进度/滚动)
     高度半圆
   字体:保持系统原生栈(桌面原生渲染 hinting 优于自托管 web 字体;
   与文档站 Geist 不做字面一致,品牌一致性经色彩/形状语言达成)。
   字号刻度(全表仅此四档,数字展示位可上浮):
     12 caption(表头/说明/统计标签) · 14 body(默认)
     16 title(节标题/卡片文件名) · 20 page/hero 标题与关键数字
   与 fluent_light.qss 严格成对:新增/删除规则必须同步两份。
   ============================================================ */

/* ---------- 0. 通用基底 ----------
   QWidget 不设背景:容器透明继承父级;背景只在窗口根与
   明确的表面类控件上给出。 */
QWidget {
    color: {{text}};
    font-family: "Segoe UI Variable Text", "Segoe UI", -apple-system,
                 "PingFang SC", "Microsoft YaHei", sans-serif;
    font-size: 14px;
}

QMainWindow, QDialog {
    background-color: {{window}};
}

#centralWidget {
    background-color: {{window}};
}

QLabel {
    background: transparent;
    color: {{text}};
}

/* ---------- 1. 控件通用 ---------- */

/* 次级按钮(细边框、暖深底) */
QPushButton {
    background-color: {{input_bg}};
    color: {{text}};
    border: 1px solid {{divider}};
    border-radius: 8px;
    padding: 6px 14px;
    min-height: 14px;
}

QPushButton:hover {
    background-color: rgba(255, 255, 255, 15);
}

QPushButton:pressed {
    background-color: rgba(255, 255, 255, 28);
}

QPushButton:focus {
    border-color: {{accent}};
}

QPushButton:disabled {
    background-color: {{surface}};
    color: {{text_disabled}};
    border-color: {{card}};
}

/* 主按钮:每组操作唯一 accent 实底(dark 下 accent 变亮,文字转深) */
QPushButton#primaryButton {
    background-color: {{accent}};
    color: {{accent_text}};
    border: none;
    border-radius: 8px;
    padding: 7px 16px;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: {{accent_hover}};
}

QPushButton#primaryButton:pressed {
    background-color: {{accent_pressed}};
}

QPushButton#primaryButton:disabled {
    background-color: {{input_bg}};
    color: {{text_disabled}};
}

/* ghost 工具钮:透明底,悬停浅灰 */
QPushButton#toolButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 6px 10px;
    color: {{text_secondary}};
}

QPushButton#toolButton:hover {
    background-color: rgba(255, 255, 255, 15);
    color: {{text}};
}

QPushButton#toolButton:pressed {
    background-color: rgba(255, 255, 255, 28);
}

/* 表格行内图标钮 / 卡片操作钮 */
QPushButton#rowActionButton,
QPushButton#cardActionButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    min-width: 0;
    padding: 4px;
}

QPushButton#rowActionButton:hover,
QPushButton#cardActionButton:hover {
    background-color: rgba(255, 255, 255, 15);
}

QPushButton#rowActionButton:pressed,
QPushButton#cardActionButton:pressed {
    background-color: rgba(255, 255, 255, 28);
}

QPushButton#rowActionButton:disabled,
QPushButton#cardActionButton:disabled {
    background: transparent;
}

/* 窗口控制钮:圆角胶囊按钮(与全局 8px 圆角语言统一,不再贴边直角) */
QPushButton#windowButton,
QPushButton#closeButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    min-width: 0;
    padding: 0;
}

QPushButton#windowButton:hover {
    background-color: rgba(255, 255, 255, 26);
}

QPushButton#windowButton:pressed {
    background-color: rgba(255, 255, 255, 40);
}

QPushButton#closeButton:hover {
    background-color: {{danger}};
    icon: url(:/icons/x-on-light.svg);
}

QPushButton#closeButton:pressed {
    background-color: {{danger_pressed}};
    icon: url(:/icons/x-on-light.svg);
}

/* ---------- 2. 输入控件 ---------- */

QLineEdit {
    background-color: {{input_bg}};
    color: {{text}};
    border: 1px solid {{divider}};
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: {{accent}};
    selection-color: {{accent_text}};
}

QLineEdit:focus {
    border-color: {{accent}};
}

QLineEdit:disabled {
    background-color: {{surface}};
    color: {{text_disabled}};
    border-color: {{card}};
}

QLineEdit#searchEdit {
    padding: 7px 12px;
    border-radius: 8px;
}

QComboBox {
    background-color: {{input_bg}};
    color: {{text}};
    border: 1px solid {{divider}};
    border-radius: 8px;
    padding: 6px 28px 6px 10px;
}

QComboBox:hover {
    background-color: rgba(255, 255, 255, 15);
}

QComboBox:focus {
    border-color: {{accent}};
}

QComboBox:disabled {
    color: {{text_disabled}};
    border-color: {{card}};
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: {{surface}};
    color: {{text}};
    border: 1px solid {{card}};
    selection-background-color: rgba(255, 255, 255, 15);
    selection-color: {{text}};
    outline: none;
}

QSpinBox {
    background-color: {{input_bg}};
    color: {{text}};
    border: 1px solid {{divider}};
    border-radius: 8px;
    padding: 5px 8px;
}

QSpinBox:focus {
    border-color: {{accent}};
}

QCheckBox {
    background: transparent;
    color: {{text}};
    spacing: 8px;
}

QCheckBox:disabled {
    color: {{text_disabled}};
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

/* 指示器 = qrc SVG（Qt QSS 不支持 data: URI，2026-10-04 B23 根因——
   此前的 data:image/svg+xml;base64 形态零渲染，勾选/未勾选全不可见） */
QCheckBox::indicator:unchecked {
    image: url(:/icons/checkbox-unchecked-dark.svg);
}

QCheckBox::indicator:checked {
    image: url(:/icons/checkbox-checked-dark.svg);
}

QGroupBox {
    background-color: {{surface}};
    border: 1px solid {{card}};
    border-radius: 12px;
    margin-top: 0px;
    padding: 26px 8px 10px 8px;
    font-size: 14px;
}

/* 标题绘制在卡片内部(padding 区)——margin origin 会把标题画到
   widget 矩形之外被裁剪(上半截消失),padding origin 绝不裁剪 */
QGroupBox::title {
    subcontrol-origin: padding;
    subcontrol-position: top left;
    left: 24px;
    top: 8px;
    background-color: transparent;
    color: {{text_secondary}};
    font-size: 12px;
    font-weight: 600;
}

/* ---------- 3. 菜单与提示 ---------- */

QMenu {
    background-color: {{surface}};
    color: {{text}};
    border: 1px solid {{card}};
    border-radius: 12px;
    padding: 4px;
}

QMenu::item {
    padding: 7px 24px 7px 12px;
    border-radius: 4px;
    background: transparent;
}

QMenu::item:selected {
    background-color: rgba(255, 255, 255, 15);
}

QMenu::item:disabled {
    color: {{text_disabled}};
}

QMenu::separator {
    height: 1px;
    background-color: {{card}};
    margin: 4px 8px;
}

QToolTip {
    background-color: {{surface}};
    color: {{text}};
    border: 1px solid {{card}};
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

/* ---------- 4. 表格与滚动条 ---------- */

QTableWidget, QTableView {
    background-color: transparent;
    alternate-background-color: transparent;
    border: none;
    gridline-color: transparent;
    outline: none;
    selection-background-color: rgba(255, 255, 255, 28);
    selection-color: {{text}};
}

#taskTable::item {
    height: 56px;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 10);
    padding: 4px 8px;
}

#taskTable::item:hover {
    background-color: rgba(255, 255, 255, 15);
}

#taskTable::item:selected {
    background-color: rgba(255, 255, 255, 28);
}

QHeaderView {
    background: transparent;
    border: none;
}

QHeaderView::section {
    background-color: transparent;
    color: {{text_secondary}};
    padding: 8px;
    border: none;
    border-bottom: 1px solid {{card}};
    font-size: 12px;
    font-weight: 600;
}

QTableCornerButton::section {
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: rgba(255, 255, 255, 60);
    border-radius: 3px;
    min-height: 32px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(255, 255, 255, 90);
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: rgba(255, 255, 255, 60);
    border-radius: 3px;
    min-width: 32px;
}

QScrollBar::handle:horizontal:hover {
    background-color: rgba(255, 255, 255, 90);
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ---------- 5. 进度指示 ---------- */

QProgressBar {
    background-color: rgba(255, 255, 255, 20);
    border: none;
    border-radius: 2px;
    min-height: 4px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: {{accent}};
    border-radius: 2px;
}

/* 进度条不承载文字,百分比由旁边的 #progressPctLabel 展示 */
#taskProgressBar {
    min-height: 6px;
    border-radius: 3px;
}

#taskProgressBar::chunk {
    border-radius: 3px;
}

#cardProgressBar {
    min-height: 4px;
}

#progressPctLabel {
    background: transparent;
    color: {{text_secondary}};
    font-size: 12px;
}

/* ---------- 6. 顶栏 ---------- */

#topBar {
    background-color: {{window}};
    border-bottom: 1px solid {{card}};
}

#brandMark {
    background: transparent;
}

#brandTitle {
    background: transparent;
    color: {{text}};
    font-size: 16px;
    font-weight: 600;
}

/* ---------- 7. 侧栏 ---------- */

#sideBar {
    background-color: {{window}};
    border-right: 1px solid {{card}};
}

/* 导航项:透明底 + 3px 左缘占位(选中态换 accent 条,文字不跳) */
QPushButton#navTab {
    background: transparent;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 4px;
    padding: 9px 12px 9px 9px;
    text-align: left;
    color: {{text_secondary}};
}

QPushButton#navTab:hover {
    background-color: rgba(255, 255, 255, 15);
    color: {{text}};
}

QPushButton#navTab:checked {
    background-color: {{surface_deep}};
    border-left: 3px solid {{accent}};
    color: {{accent}};
    font-weight: 600;
}

QLabel#sectionLabel {
    background: transparent;
    color: {{text_secondary}};
    font-size: 12px;
    font-weight: 600;
}

#sideBarFooter {
    background: transparent;
    border-top: 1px solid {{card}};
}

#sidebarStatValue {
    background: transparent;
    color: {{text}};
    font-size: 16px;
    font-weight: 600;
}

#sidebarStatLabel {
    background: transparent;
    color: {{text_secondary}};
    font-size: 12px;
}

/* ---------- 8. 状态栏 ---------- */

#statusBar {
    background-color: {{window}};
    border-top: 1px solid {{card}};
}

#statusBarLabel {
    background: transparent;
    color: {{text_secondary}};
    font-size: 12px;
}

/* ---------- 9. 下载页 ---------- */

#downloadHero {
    background-color: {{surface}};
    border: 1px solid {{card}};
    border-radius: 12px;
}

#heroTitle {
    background: transparent;
    color: {{text}};
    font-size: 20px;
    font-weight: 600;
}

#heroDescription {
    background: transparent;
    color: {{text_secondary}};
}

#downloadToolbar {
    background: transparent;
}

/* 页头分段切换器(下载中|已完成):暖底胶囊 + 高亮选中段 */
#viewSegmented {
    background-color: rgba(255, 255, 255, 20);
    border: 1px solid {{card}};
    border-radius: 8px;
}

QPushButton#viewSegmentButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 16px;
    color: {{text_secondary}};
}

QPushButton#viewSegmentButton:hover {
    color: {{text}};
}

QPushButton#viewSegmentButton:checked {
    background-color: {{surface_deep}};
    border: 1px solid {{divider_weak}};
    color: {{accent}};
    font-weight: 600;
}

#summaryCard {
    background-color: {{surface}};
    border: 1px solid {{card}};
    border-radius: 12px;
}

#summaryValue {
    background: transparent;
    color: {{text}};
    font-size: 20px;
    font-weight: 600;
}

#summaryCaption {
    background: transparent;
    color: {{text_secondary}};
    font-size: 12px;
}

#taskCard {
    background-color: {{surface}};
    border: 1px solid {{card}};
    border-radius: 12px;
}

#taskCard:hover {
    border-color: {{divider_weak}};
}

#cardFileName {
    background: transparent;
    color: {{text}};
    font-size: 14px;
    font-weight: 600;
}

#cardInfoLabel {
    background: transparent;
    color: {{text_secondary}};
    font-size: 12px;
}

#gridScrollArea,
QScrollArea#gridScrollArea > QWidget > QWidget {
    background: transparent;
    border: none;
}

#emptyStateTitle {
    background: transparent;
    color: {{text}};
    font-size: 20px;
    font-weight: 600;
}

#emptyStateBody {
    background: transparent;
    color: {{text_secondary}};
    font-size: 13px;
}

/* ---------- 10. 节标题(卡片内小节) ---------- */

#sectionTitle {
    background: transparent;
    color: {{text}};
    font-size: 16px;
    font-weight: 600;
}

/* ---------- 11. 通用杂项 ---------- */

#separatorLine {
    background-color: {{card}};
    border: none;
    max-height: 1px;
}
