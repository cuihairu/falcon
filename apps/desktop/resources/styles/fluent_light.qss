/* ============================================================
   Falcon Desktop · Warm Console Light
   token: window #f6f4f1 · card #ffffff · text #292524
          text-secondary #57534e · text-disabled #a8a29e
          accent #c2410c (hover #9a3412 / pressed #7c2d12)
          divider #e7e5e4 · hover rgba(0,0,0,10) · danger #c42b1c
   设计语言与文档站同源「warm console」:暖石中性底 + falcon 橙
   单强调;对比度基线 WCAG AA(#c2410c 于亮底 4.8:1,白字于其上 5.0:1)。
   形状刻度(单一规则,全表执行):
     按钮/输入 8px · 卡片/面板(组框/菜单/Hero/任务卡) 12px
     · 小件(工具钮/行内钮/菜单项/提示/导航段) 4px · 条形(进度/滚动)
     高度半圆
   字体:保持系统原生栈(桌面原生渲染 hinting 优于自托管 web 字体;
   与文档站 Geist 不做字面一致,品牌一致性经色彩/形状语言达成)。
   字号刻度(全表仅此四档,数字展示位可上浮):
     12 caption(表头/说明/统计标签) · 14 body(默认)
     16 title(节标题/卡片文件名) · 20 page/hero 标题与关键数字
   与 fluent_dark.qss 严格成对:新增/删除规则必须同步两份。
   ============================================================ */

/* ---------- 0. 通用基底 ----------
   QWidget 不设背景:容器透明继承父级,白卡片上不再出现灰色块;
   背景只在窗口根与明确的表面类控件上给出。 */
QWidget {
    color: #292524;
    font-family: "Segoe UI Variable Text", "Segoe UI", -apple-system,
                 "PingFang SC", "Microsoft YaHei", sans-serif;
    font-size: 14px;
}

QMainWindow, QDialog {
    background-color: #f6f4f1;
}

#centralWidget {
    background-color: #f6f4f1;
}

QLabel {
    background: transparent;
    color: #292524;
}

/* ---------- 1. 控件通用 ---------- */

/* 次级按钮(细边框、白底) */
QPushButton {
    background-color: #ffffff;
    color: #292524;
    border: 1px solid #dcd7d1;
    border-radius: 8px;
    padding: 6px 14px;
    min-height: 14px;
}

QPushButton:hover {
    background-color: #f5f2ee;
}

QPushButton:pressed {
    background-color: rgba(0, 0, 0, 10);
}

QPushButton:focus {
    border-color: #c2410c;
}

QPushButton:disabled {
    background-color: #f6f4f1;
    color: #a8a29e;
    border-color: #e7e5e4;
}

/* 主按钮:每组操作唯一 accent 实底 */
QPushButton#primaryButton {
    background-color: #c2410c;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 7px 16px;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #9a3412;
}

QPushButton#primaryButton:pressed {
    background-color: #7c2d12;
}

QPushButton#primaryButton:disabled {
    background-color: #e8e3dd;
    color: #a8a29e;
}

/* ghost 工具钮:透明底,悬停浅灰 */
QPushButton#toolButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 6px 10px;
    color: #57534e;
}

QPushButton#toolButton:hover {
    background-color: rgba(0, 0, 0, 10);
    color: #292524;
}

QPushButton#toolButton:pressed {
    background-color: rgba(0, 0, 0, 18);
}

/* 表格行内图标钮 / 卡片操作钮 */
QPushButton#rowActionButton,
QPushButton#cardActionButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    min-width: 0;
    padding: 4px;
}

QPushButton#rowActionButton:hover,
QPushButton#cardActionButton:hover {
    background-color: rgba(0, 0, 0, 10);
}

QPushButton#rowActionButton:pressed,
QPushButton#cardActionButton:pressed {
    background-color: rgba(0, 0, 0, 18);
}

QPushButton#rowActionButton:disabled,
QPushButton#cardActionButton:disabled {
    background: transparent;
}

/* 窗口控制钮:无边框贴边,close 悬停红(亮暗同值) */
QPushButton#windowButton,
QPushButton#closeButton {
    background: transparent;
    border: none;
    border-radius: 0;
    min-width: 0;
    padding: 0;
}

QPushButton#windowButton:hover {
    background-color: rgba(0, 0, 0, 10);
}

QPushButton#windowButton:pressed {
    background-color: rgba(0, 0, 0, 18);
}

QPushButton#closeButton:hover {
    background-color: #c42b1c;
}

QPushButton#closeButton:pressed {
    background-color: #b02c1c;
}

/* ---------- 2. 输入控件 ---------- */

QLineEdit {
    background-color: #ffffff;
    color: #292524;
    border: 1px solid #dcd7d1;
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: #c2410c;
    selection-color: #ffffff;
}

QLineEdit:focus {
    border-color: #c2410c;
}

QLineEdit:disabled {
    background-color: #f6f4f1;
    color: #a8a29e;
    border-color: #e7e5e4;
}

QLineEdit#searchEdit {
    padding: 7px 12px;
    border-radius: 8px;
}

QComboBox {
    background-color: #ffffff;
    color: #292524;
    border: 1px solid #dcd7d1;
    border-radius: 8px;
    padding: 6px 28px 6px 10px;
}

QComboBox:hover {
    background-color: #f5f2ee;
}

QComboBox:focus {
    border-color: #c2410c;
}

QComboBox:disabled {
    color: #a8a29e;
    border-color: #e7e5e4;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #292524;
    border: 1px solid #e7e5e4;
    selection-background-color: rgba(0, 0, 0, 10);
    selection-color: #292524;
    outline: none;
}

QSpinBox {
    background-color: #ffffff;
    color: #292524;
    border: 1px solid #dcd7d1;
    border-radius: 8px;
    padding: 5px 8px;
}

QSpinBox:focus {
    border-color: #c2410c;
}

QCheckBox {
    background: transparent;
    color: #292524;
    spacing: 8px;
}

QCheckBox:disabled {
    color: #a8a29e;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator:unchecked {
    image: url(data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxNiIgaGVpZ2h0PSIxNiI+PHJlY3QgeD0iMC41IiB5PSIwLjUiIHdpZHRoPSIxNSIgaGVpZ2h0PSIxNSIgcng9IjMiIGZpbGw9IiNmZmZmZmYiIHN0cm9rZT0iI2EyOWE5MiIvPjwvc3ZnPg==);
}

QCheckBox::indicator:checked {
    image: url(data:image/svg+xml;base64,);
}

QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e7e5e4;
    border-radius: 12px;
    margin-top: 0px;
    padding: 26px 8px 10px 8px;
    font-size: 14px;
}

/* 标题绘制在卡片内部(padding 区)——margin origin 会把标题画到
   widget 矩形之外被裁剪(上半截消失),padding origin 绝不裁剪 */
QGroupBox::title {
    subcontrol-origin: padding;
    subcontrol-position: top left;
    left: 24px;
    top: 8px;
    background-color: transparent;
    color: #57534e;
    font-size: 12px;
    font-weight: 600;
}

/* ---------- 3. 菜单与提示 ---------- */

QMenu {
    background-color: #ffffff;
    color: #292524;
    border: 1px solid #e7e5e4;
    border-radius: 12px;
    padding: 4px;
}

QMenu::item {
    padding: 7px 24px 7px 12px;
    border-radius: 4px;
    background: transparent;
}

QMenu::item:selected {
    background-color: rgba(0, 0, 0, 10);
}

QMenu::item:disabled {
    color: #a8a29e;
}

QMenu::separator {
    height: 1px;
    background-color: #e7e5e4;
    margin: 4px 8px;
}

QToolTip {
    background-color: #ffffff;
    color: #292524;
    border: 1px solid #e7e5e4;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

/* ---------- 4. 表格与滚动条 ---------- */

QTableWidget, QTableView {
    background-color: transparent;
    alternate-background-color: transparent;
    border: none;
    gridline-color: transparent;
    outline: none;
    selection-background-color: rgba(0, 0, 0, 18);
    selection-color: #292524;
}

#taskTable::item {
    height: 56px;
    border: none;
    border-bottom: 1px solid rgba(0, 0, 0, 8);
    padding: 4px 8px;
}

#taskTable::item:hover {
    background-color: rgba(0, 0, 0, 10);
}

#taskTable::item:selected {
    background-color: rgba(0, 0, 0, 18);
}

QHeaderView {
    background: transparent;
    border: none;
}

QHeaderView::section {
    background-color: transparent;
    color: #57534e;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #e7e5e4;
    font-size: 12px;
    font-weight: 600;
}

QTableCornerButton::section {
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: rgba(0, 0, 0, 60);
    border-radius: 3px;
    min-height: 32px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(0, 0, 0, 90);
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: rgba(0, 0, 0, 60);
    border-radius: 3px;
    min-width: 32px;
}

QScrollBar::handle:horizontal:hover {
    background-color: rgba(0, 0, 0, 90);
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ---------- 5. 进度指示 ---------- */

QProgressBar {
    background-color: rgba(0, 0, 0, 12);
    border: none;
    border-radius: 2px;
    min-height: 4px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #c2410c;
    border-radius: 2px;
}

/* 进度条不承载文字,百分比由旁边的 #progressPctLabel 展示 */
#taskProgressBar {
    min-height: 6px;
    border-radius: 3px;
}

#taskProgressBar::chunk {
    border-radius: 3px;
}

#cardProgressBar {
    min-height: 4px;
}

#progressPctLabel {
    background: transparent;
    color: #57534e;
    font-size: 12px;
}

/* ---------- 6. 顶栏 ---------- */

#topBar {
    background-color: #f6f4f1;
    border-bottom: 1px solid #e7e5e4;
}

#brandMark {
    background: transparent;
}

#brandTitle {
    background: transparent;
    color: #292524;
    font-size: 16px;
    font-weight: 600;
}

/* ---------- 7. 侧栏 ---------- */

#sideBar {
    background-color: #f6f4f1;
    border-right: 1px solid #e7e5e4;
}

/* 导航项:透明底 + 3px 左缘占位(选中态换 accent 条,文字不跳) */
QPushButton#navTab {
    background: transparent;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 4px;
    padding: 9px 12px 9px 9px;
    text-align: left;
    color: #57534e;
}

QPushButton#navTab:hover {
    background-color: rgba(0, 0, 0, 10);
    color: #292524;
}

QPushButton#navTab:checked {
    background-color: #ffffff;
    border-left: 3px solid #c2410c;
    color: #c2410c;
    font-weight: 600;
}

QLabel#sectionLabel {
    background: transparent;
    color: #57534e;
    font-size: 12px;
    font-weight: 600;
}

#sideBarFooter {
    background: transparent;
    border-top: 1px solid #e7e5e4;
}

#sidebarStatValue {
    background: transparent;
    color: #292524;
    font-size: 16px;
    font-weight: 600;
}

#sidebarStatLabel {
    background: transparent;
    color: #57534e;
    font-size: 12px;
}

/* ---------- 8. 状态栏 ---------- */

#statusBar {
    background-color: #f6f4f1;
    border-top: 1px solid #e7e5e4;
}

#statusBarLabel {
    background: transparent;
    color: #57534e;
    font-size: 12px;
}

/* ---------- 9. 下载页 ---------- */

#downloadHero {
    background-color: #ffffff;
    border: 1px solid #e7e5e4;
    border-radius: 12px;
}

#heroTitle {
    background: transparent;
    color: #292524;
    font-size: 20px;
    font-weight: 600;
}

#heroDescription {
    background: transparent;
    color: #57534e;
}

#downloadToolbar {
    background: transparent;
}

/* 页头分段切换器(下载中|已完成):石底胶囊 + 白底选中段 */
#viewSegmented {
    background-color: #edeae5;
    border: 1px solid #e7e5e4;
    border-radius: 8px;
}

QPushButton#viewSegmentButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 16px;
    color: #57534e;
}

QPushButton#viewSegmentButton:hover {
    color: #292524;
}

QPushButton#viewSegmentButton:checked {
    background-color: #ffffff;
    border: 1px solid #dcd7d1;
    color: #c2410c;
    font-weight: 600;
}

#summaryCard {
    background-color: #ffffff;
    border: 1px solid #e7e5e4;
    border-radius: 12px;
}

#summaryValue {
    background: transparent;
    color: #292524;
    font-size: 20px;
    font-weight: 600;
}

#summaryCaption {
    background: transparent;
    color: #57534e;
    font-size: 12px;
}

#taskCard {
    background-color: #ffffff;
    border: 1px solid #e7e5e4;
    border-radius: 12px;
}

#taskCard:hover {
    border-color: #cac2b9;
}

#cardFileName {
    background: transparent;
    color: #292524;
    font-size: 14px;
    font-weight: 600;
}

#cardInfoLabel {
    background: transparent;
    color: #57534e;
    font-size: 12px;
}

#gridScrollArea,
QScrollArea#gridScrollArea > QWidget > QWidget {
    background: transparent;
    border: none;
}

#emptyStateTitle {
    background: transparent;
    color: #292524;
    font-size: 20px;
    font-weight: 600;
}

#emptyStateBody {
    background: transparent;
    color: #57534e;
    font-size: 13px;
}

/* ---------- 10. 节标题(卡片内小节) ---------- */

#sectionTitle {
    background: transparent;
    color: #292524;
    font-size: 16px;
    font-weight: 600;
}

/* ---------- 11. 通用杂项 ---------- */

#separatorLine {
    background-color: #e7e5e4;
    border: none;
    max-height: 1px;
}
